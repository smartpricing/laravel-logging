{
    "name": "smartness/laravel-logging",
    "description": "Structured JSON logging for Laravel with bounded normalization, redaction and request/job correlation",
    "keywords": ["laravel", "logging", "monolog", "json", "loki", "structured-logging"],
    "homepage": "https://github.com/smartpricing/laravel-logging",
    "support": {
        "issues": "https://github.com/smartpricing/laravel-logging/issues",
        "source": "https://github.com/smartpricing/laravel-logging"
    },
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "open-telemetry/api": "Attach the currently active trace and span IDs"
    },
    "autoload": {
        "psr-4": {"Smartness\\LaravelLogging\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Smartness\\LaravelLogging\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Smartness\\LaravelLogging\\StructuredLoggingServiceProvider"]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
