local.file_match "application" {
  path_targets = [{ __path__ = "/logs/laravel.log", job = "laravel-logging-smoke" }]
}

loki.source.file "application" {
  targets    = local.file_match.application.targets
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  stage.json {
    expressions = { timestamp = "timestamp", service = "service", environment = "environment", component = "component", level = "level" }
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = { service = "", environment = "", component = "", level = "" }
  }
  // Request/job IDs remain in the JSON body and are never indexed as labels.
  stage.label_drop {
    values = ["filename"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
